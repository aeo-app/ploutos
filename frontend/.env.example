# Copy to .env.production before building for production deployment.
# CRA embeds REACT_APP_* variables at BUILD TIME — this must be set before
# running `npm run build`, not just present at runtime; a build made
# without it will always call the local dev API URL, regardless of where
# it's actually deployed.
REACT_APP_API_BASE_URL=https://api.aeo-app.ai/api/v1

# Must match the BACKEND's own AIRWALLEX_ENV setting exactly — a mismatch
# produces Airwallex's "Access denied, authentication failed" error, since a
# PaymentIntent's client_secret only works in the same environment
# (demo/sandbox vs prod) it was created in.
REACT_APP_AIRWALLEX_ENV=prod
