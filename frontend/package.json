{
  "name": "apac-seo-intelligence",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@airwallex/components-sdk": "^1.32.0",
    "framer-motion": "^11.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-scripts": "5.0.1",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/generate-sitemap.js && node scripts/generate-llms-txt.js && react-scripts build && node scripts/prerender/index.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "llms-txt": "node scripts/generate-llms-txt.js",
    "prerender": "node scripts/prerender/index.js",
    "deploy": "npm run build && aws s3 sync build s3://www.aeo-app.ai --delete"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.5"
  }
}
