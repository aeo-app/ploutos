#!/usr/bin/env bash
set -euo pipefail

exec > /var/log/ploutos-bootstrap.log 2>&1

export DEBIAN_FRONTEND=noninteractive

apt-get update -qq
apt-get install -y -qq \
  ca-certificates curl git python3-pip python3-venv

pip3 install uv --quiet

APP_DIR="/home/ubuntu/${project_name}"
mkdir -p "$APP_DIR"

cat > "$APP_DIR/.env" << EOF
AWS_REGION=${aws_region}
COGNITO_USER_POOL_ID=${cognito_user_pool_id}
COGNITO_CLIENT_ID=${cognito_client_id}
COGNITO_REGION=${aws_region}
CONTACT_EMAIL=${contact_email}
CONTACT_SENDER=${contact_sender}
%{ if bedrock_assume_role_arn != "" ~}
BEDROCK_ASSUME_ROLE_ARN=${bedrock_assume_role_arn}
%{ endif ~}
TAVILY_API_KEY=$(aws secretsmanager get-secret-value \
  --secret-id "${tavily_api_key_secret}" \
  --query SecretString \
  --output text \
  --region "${aws_region}")
EOF

chown -R ubuntu:ubuntu "$APP_DIR"

cat > /etc/systemd/system/${project_name}-gate.service << UNIT
[Unit]
Description=${project_name^} Gate API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=$APP_DIR/${project_name}-gate
ExecStart=$APP_DIR/${project_name}-gate/start.sh
Restart=on-failure
RestartSec=5
Environment=UV_CACHE_DIR=/tmp/uv-cache

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable ${project_name}-gate
