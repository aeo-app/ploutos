# Environment / secrets — never commit real credentials.
# .env.example is the template and SHOULD be committed.
.env
env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# uv / venv — uv.lock SHOULD be committed (reproducible installs); the
# virtual environment itself should not.
.venv/

# Terraform — state files contain sensitive resource data and should never
# be committed; use a remote backend (S3 + DynamoDB lock table) instead.
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars

# Editor / OS
.DS_Store
.vscode/
.idea/
