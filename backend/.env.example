# Copy this file to .env and fill in real values.
# Local dev shortcuts (SKIP_JWT_VERIFICATION, SKIP_PAYMENT_VERIFICATION,
# DYNAMODB_ENDPOINT_URL) let you run the API without real Cognito/Airwallex/
# AWS credentials — see README.md "Local development" for the fastest path.

# Where the React frontend actually runs — used to build the browser
# redirect after every OAuth flow completes (Canva, Meta, LinkedIn, Google
# Business). MUST be the frontend's real origin, not this backend's — they
# are typically NOT the same in local dev (backend on 8000, CRA dev server
# on 3000), and may or may not be the same in production depending on your
# deployment. Getting this wrong sends the browser to this backend's own
# root endpoint instead of the app after connecting.
FRONTEND_URL=http://localhost:3000

# ── AWS (general) ────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
# Only needed for local dev without an IAM role attached (EC2/ECS/Lambda
# already have one). Leave unset in production.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── AWS Cognito (user auth) ──────────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# true = accept unsigned/stub-decoded JWTs (or the X-User-ID header) instead
# of verifying against Cognito. NEVER set true in production.
SKIP_JWT_VERIFICATION=false

# ── AWS Bedrock (Nova Pro — SEO/content/social generation) ──────────────────
BEDROCK_AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Cross-account STS role Bedrock calls assume. Required unless you switch
# services/bedrock_service.py to call Bedrock directly with the AWS creds above.
ROLE_ARN=
EIGENAI_AWS_ACCESS_KEY_ID=
EIGENAI_AWS_SECRET_ACCESS_KEY=
EIGENAI_AWS_SESSION_TOKEN=
BEDROCK_READ_TIMEOUT_SECONDS=90
# Per-call token ceilings — see services/bedrock_service.py and
# services/social_service.py module docstrings for why these are bounded
# rather than one large call.
BEDROCK_MAX_TOKENS=4096
BEDROCK_ANALYSIS_MAX_TOKENS=3000
BEDROCK_BACKLINK_MAX_TOKENS=3500
BEDROCK_CONTENT_MAX_TOKENS=3500
BEDROCK_MAX_CONCURRENT_KEYWORDS=3

# ── DynamoDB (analyses) ───────────────────────────────────────────────────────
APAC_SEO_TABLE=apac_seo_analyses
# Auto-expire saved analyses after N days (0 = never). Applies the TTL
# attribute at table-creation time — see db/dynamo.py create_table_if_not_exists.
ANALYSIS_TTL_DAYS=0

# ── DynamoDB (payments & entitlements — a SEPARATE table from analyses) ─────
# See db/payments_dynamo.py. Its own table, its own GSI
# (gsi_payment_intent_id), its own connection — payment/billing data no
# longer lives alongside SEO analysis data.
APAC_PAYMENTS_TABLE=apac_payments
# Set to a local DynamoDB endpoint (e.g. http://localhost:8000) for local
# dev — the app will auto-create the table + GSI on startup when this is
# set. Leave unset in production (real DynamoDB, provisioned via
# Terraform/CDK/CloudFormation — see infra/).
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ── Airwallex (payment gate) ──────────────────────────────────────────────────
# "demo" = sandbox, "prod" = live. From Airwallex web app > Developer > API keys.
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# ── Canva (poster generation for the relocation social calendar) ────────────
# Requires a Canva Enterprise subscription — both the integration's Canva
# account AND every end-user who connects must be members of that same
# Canva Enterprise organization (Autofill + Brand Template APIs are
# Enterprise-gated). From the Canva Developer Portal > your integration.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must exactly match one of the redirect URLs registered for this
# integration in the Canva Developer Portal (Authentication > Authorized
# redirects — up to 10 URLs can be registered at once, so keep both your
# local dev and production URLs registered simultaneously). Canva does NOT
# accept "localhost" for local dev — use 127.0.0.1 (confirmed in Canva's
# own docs: "For local development, you can add http://127.0.0.1:<port> as
# a redirect URL (localhost isn't allowed).").
CANVA_REDIRECT_URI=http://127.0.0.1:8000/api/v1/canva/callback
CANVA_TIMEOUT_SECONDS=20

# ── Admin panel ───────────────────────────────────────────────────────────────
# RBAC has two layers (see core/security.py's require_admin):
#   1. Cognito Groups ("Admins" — see infra/cognito.tf) — canonical, checked
#      via the JWT's cognito:groups claim, no DB read needed. Manage via
#      POST /api/v1/admin/users/{user_id}/set-admin or the AWS Console.
#      NOTE: a promoted user only sees the effect after their token is
#      re-issued (next login/refresh) — it does not apply to a live session.
#   2. DynamoDB fallback (db.dynamo.is_admin/set_admin) — takes effect
#      immediately, and is what local/dev mode (SKIP_JWT_VERIFICATION) uses
#      since there's no real Cognito token to read a groups claim from.
# ADMIN_EMAILS (comma-separated) auto-promotes matching signups/logins via
# BOTH mechanisms — bootstraps the first admin without a chicken-and-egg
# problem. After that, promote others via the endpoint above instead of
# editing this list.
ADMIN_EMAILS=
# Only needed if you rename the Cognito group created in infra/cognito.tf
# away from the default "Admins".
COGNITO_ADMIN_GROUP=Admins
# Per notification-URL secret from Airwallex web app > Developer > Webhooks.
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_TIMEOUT_SECONDS=15
# Three plans, priced differently — every paid plan gets full access (no
# feature gating between tiers yet). Currency is shared across all plans.
# The dashboard's pricing UI should read prices from GET /payment/plans
# rather than hardcoding them, so it can never drift out of sync with these.
PAYMENT_CURRENCY=USD
PLAN_STARTER_PRICE=29.00
PLAN_GROWTH_PRICE=99.00
PLAN_SCALE_PRICE=179.00
# Manual renewal, not auto-recurring — no card is stored on file and nothing
# charges automatically. A successful payment grants this many days of
# access, after which the user pays again. 0 = one-time-forever access instead.
PAID_ACCESS_DAYS=30
# true = every protected endpoint is open regardless of payment status.
# NEVER set true in production.
SKIP_PAYMENT_VERIFICATION=false

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Direct social media posting (Facebook, Instagram, LinkedIn, Google
# Business Profile) — see services/social_publish/*.py for exactly what
# each of these requires (app review, business verification, etc.) before
# it works in production. Getting credentials is a real, separate process
# per platform, not something this app can do for you.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social-publish/meta/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social-publish/linkedin/callback
LINKEDIN_API_VERSION=202603

GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:8000/api/v1/social-publish/google_business/callback

SOCIAL_PUBLISH_TIMEOUT_SECONDS=20

# ── User-uploaded media (for direct posting, alongside Canva posters) ──────
MEDIA_UPLOAD_BUCKET=aeo-app-media-uploads

# ── Scheduled social posts (Facebook + Instagram) ───────────────────────────
# Instagram has no native "post later" API — this app runs its own
# in-process scheduler (see main.py, services/social_publish/scheduler.py)
# that polls for due posts. Must run as a persistent process for this to
# work — a per-request serverless deployment would never let a job fire
# between requests.
SCHEDULED_POSTS_POLL_SECONDS=60

# ── Article Generator (research brief + full article) ──────────────────────
BEDROCK_ARTICLE_MAX_TOKENS=7000
