{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-1:*:table/apac_seo_analyses",
        "arn:aws:dynamodb:ap-southeast-1:*:table/apac_seo_analyses/index/gsi_analysis_id",
        "arn:aws:dynamodb:ap-southeast-1:*:table/apac_payments",
        "arn:aws:dynamodb:ap-southeast-1:*:table/apac_payments/index/gsi_payment_intent_id"
      ]
    },
    {
      "Sid": "CognitoAdminActionsForAppRole",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminRemoveUserFromGroup",
        "cognito-idp:ListUsersInGroup",
        "cognito-idp:GetUser"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-1:*:userpool/*"
    },
    {
      "Sid": "MediaUploadBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::aeo-app-media-uploads/*"
    }
  ]
}
