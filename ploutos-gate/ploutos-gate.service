[Unit]
Description=Ploutos Gate API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ploutos/ploutos-gate
ExecStart=/home/ubuntu/ploutos/ploutos-gate/start.sh
Restart=on-failure
RestartSec=5
Environment=UV_CACHE_DIR=/tmp/uv-cache

[Install]
WantedBy=multi-user.target
