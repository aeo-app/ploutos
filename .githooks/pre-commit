#!/usr/bin/env bash
set -euo pipefail

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly RESET='\033[0m'

failures=0

fail() {
  printf '%b\n' "${RED}pre-commit: $*${RESET}" >&2
  failures=$((failures + 1))
}

warn() {
  printf '%b\n' "${YELLOW}pre-commit: $*${RESET}" >&2
}

staged_files=()
while IFS= read -r -d '' file; do
  staged_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

for file in "${staged_files[@]}"; do
  case "$file" in
    *.env|*.env.*|*.tfstate|*.tfstate.*|*.pem|*.key|*.p12|*.pfx|*/.aws/credentials|.aws/credentials)
      fail "sensitive file is staged: $file"
      ;;
  esac
done

secret_patterns=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{ dix,}'
  '-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'
  '(AWS|AWS_ACCESS|AWS_SECRET|ANTHROPIC|OPENAI|GITHUB|SLACK)[A-Z_]*[[:space:]]*=[[:space:]]*["'"'][^"'"']+["'"']'
  '(api[_-]?key|access[_-]?token|secret|password|private[_-]?key)[[:space:]]*:[[:space:]]*["'"'][^"'"']+["'"']'
)

for file in "${staged_files[@]}"; do
  additions=$(git diff --cached --no-color --unified=0 --diff-filter=ACMR -- "$file" \
    | sed -n '/^+++/!{/^+/s/^+//p}')

  [[ -n "$additions" ]] || continue

  for pattern in "${secret_patterns[@]}"; do
    if matches=$(printf '%s\n' "$additions" | grep -nE "$pattern"); then
      fail "possible secret in $file: $(printf '%s' "$matches" | head -n 1 | cut -c1-160)"
    fi
  done
done

for file in "${staged_files[@]}"; do
  case "$file" in
    *.py)
      if [[ -f "$file" ]] && ! python3 -m py_compile "$file" 2>/dev/null; then
        fail "Python syntax error in $file"
      fi
      ;;
  esac
done

if (( failures > 0 )); then
  printf '%b\n' "${RED}Commit blocked: ${failures} issue(s) found.${RESET}" >&2
  exit 1
fi

printf '%b\n' "${GREEN}pre-commit: staged files passed security checks.${RESET}"